{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "whatsapp-review-integration-test": true,
      "claude/project-thread-pkg0jt": false,
      "perf/whatsapp-master-brain-window-v2-continuation-20261017": false,
      "fix/whatsapp-master-brain-kpi-truth-v3-20261017": false,
      "fix/whatsapp-master-brain-lifecycle-v4-continuation-20261017": false
    }
  },
  "installCommand": "npm install -g npm@10.9.2 && npm ci --legacy-peer-deps --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
