  "canonicalView": " WITH owners AS (\n         SELECT s_1.id AS source_id,\n            count(DISTINCT c.id) AS owner_count,\n            min(c.id::text) AS v22_case_id\n           FROM whatsapp_review_sources s_1\n             JOIN whatsapp_customer_cases_v22 c ON c.root_source_id = s_1.id OR (s_1.id = ANY (c.source_ids))\n          GROUP BY s_1.id\n        )\n SELECT s.id AS source_id,\n    o.v22_case_id::uuid AS v22_case_id\n   FROM whatsapp_review_sources s\n     JOIN owners o ON o.source_id = s.id AND o.owner_count = 1\n  WHERE COALESCE(s.review_status, ''::text) <> 'archived'::text AND NOT (EXISTS ( SELECT 1\n           FROM whatsapp_review_sources f\n          WHERE f.id <> s.id AND f.source_filename = s.source_filename AND COALESCE(f.review_status, ''::text) <> 'archived'::text AND f.conversation_started_at >= s.conversation_started_at AND f.conversation_ended_at <= s.conversation_ended_at AND COALESCE(f.raw_text, ''::text) <> ''::text AND COALESCE(s.raw_text, ''::text) <> ''::text AND POSITION((f.raw_text) IN (s.raw_text)) > 0 AND (EXISTS ( SELECT 1\n                   FROM owners o2\n                  WHERE o2.source_id = f.id))));"
}
