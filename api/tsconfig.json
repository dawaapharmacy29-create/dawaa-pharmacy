  "include": ["./**/*.ts", "../src/lib/salesIntelligence/**/*.ts", "../src/lib/customers/**/*.ts", "../src/lib/invoices/**/*.ts"],
  "exclude": ["../node_modules", "../dist", "../build", "../**/*.test.ts"]
}
