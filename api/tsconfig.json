{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "allowImportingTsExtensions": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["../node_modules", "../dist", "../build", "../src", "../**/*.test.ts"]
}
